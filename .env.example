# Local development only. Copy to .env.local or .env and fill real values there.
# Do not commit real secret keys.

# Supabase public browser config
SUPABASE_URL=https://xpmozqmqzrljvnubnnxs.supabase.co
SUPABASE_PROJECT_ID=xpmozqmqzrljvnubnnxs
SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_ME

# Supabase server/admin scripts and webhooks
# Use one of these names locally/deployment-side; never expose this to frontend code.
SUPABASE_SECRET_KEY=sb_secret_REPLACE_ME
SUPABASE_SERVICE_ROLE_KEY=

# Stripe direct Checkout Sessions
STRIPE_SECRET_KEY=sk_test_REPLACE_ME
STRIPE_WEBHOOK_SECRET=whsec_REPLACE_ME
STRIPE_PRICE_OC80_JERSEY_HOME=
STRIPE_PRICE_OC80_JERSEY_AWAY=
STRIPE_PRICE_OG_CRACK_PACK=
STRIPE_PRICE_RAW_DOC_PREORDER=
STRIPE_PRICE_BLACK_TEE=
STRIPE_PRICE_HARDCOVER_PREORDER=
STRIPE_PRICE_HANDY_SASS_PASS=
STRIPE_PRICE_CASH_FOR_TRASH_MONTHLY=
# Optional override for the shared 10% Trap Pass holder coupon.
STRIPE_TRAP_PASS_COUPON_ID=trap-pass-holder-10

# Stripe checkout routing and behavior
STRIPE_SUCCESS_URL=https://imhighoncrackandihaveagun.com/checkout/success?session_id={CHECKOUT_SESSION_ID}
STRIPE_CANCEL_URL=https://imhighoncrackandihaveagun.com/store/
STRIPE_AUTOMATIC_TAX=0
STRIPE_ALLOWED_SHIPPING_COUNTRIES=US
STRIPE_PRODUCT_ASSET_BASE_URL=https://imhighoncrackandihaveagun.com
# Local/dev escape hatch only. Keep unset or 0 in production so test keys cannot open public Sandbox Checkout.
ALLOW_TEST_STRIPE_CHECKOUT=0

# Comma-separated browser origins allowed to call checkout
CHECKOUT_ALLOWED_ORIGINS=https://imhighoncrackandihaveagun.com,https://www.imhighoncrackandihaveagun.com

# Trap Pass signup notifications. Use a verified sender/domain in Resend.
RESEND_API_KEY=
TRAP_PASS_NOTIFY_TO=imhighoncrackandihaveagun@gmail.com
TRAP_PASS_NOTIFY_FROM=IHOCAIHAG Trap Pass <trap-pass@imhighoncrackandihaveagun.com>

# Customer documentary preorder confirmations. These can reuse the verified
# Resend sender above; the optional values only change the display/reply address.
DOCUMENTARY_CONFIRMATION_FROM=IHOCAIHAG Documentary <trap-pass@imhighoncrackandihaveagun.com>
DOCUMENTARY_CONFIRMATION_REPLY_TO=imhighoncrackandihaveagun@gmail.com
